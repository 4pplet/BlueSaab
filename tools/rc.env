# The firmware release candidate the bench/car session validates.
# Single source of truth for tools/bench.sh and docs/BENCH_SESSION.md.
# CI builds are byte-reproducible: if the artifact has expired, re-run the
# workflow on RC_COMMIT and the rebuilt .bin must match RC_BIN_SHA256.
RC_VERSION=6.1.7
RC_COMMIT=2b55597
RC_RUN=36697970788
RC_BIN_SHA256=059b8888975dbf9d27aed3394c1302e3f7a9d51f1225dbf7c3eabdcd78dd2cd7

# The last published release — the known-good fallback when a unit can't be
# restored from its own backup (e.g. read protection blocked the backup).
# `tools/bench.sh restore <port> release` downloads it and checks this hash.
FALLBACK_TAG=v6.1.1
FALLBACK_BIN=BlueSaab-v6.1.1.bin
FALLBACK_BIN_SHA256=a2db3f28523361e8edad3c31bde47c4e18a64b196fdc0c5467a842838910dee2
